// FREQBEACON production Worker + trusted Explore receiver health.
{
  "name": "signal-scout",
  "compatibility_date": "2026-08-23",
  "main": "worker-program-v18.js",
  "routes": [
    { "pattern": "freqbeacon.methvindigitalworks.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "RECEIVER_HEALTH_DB"
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/zero/*",
      "/zero",
      "/zero/",
      "/zero-bench",
      "/zero-bench/",
      "/api/explore/*",
      "/explore",
      "/explore/",
      "/api/sdr/*",
      "/api/program-guide",
      "/api/program-guide/*",
      "/api/ham-activity",
      "/",
      "/index.html",
      "/full-data.js",
      "/sdr-rf-v2.js",
      "/sdr-health.js",
      "/sdr-tuning-v3.js",
      "/sdr-player.js",
      "/lookup.js"
    ]
  }
}
