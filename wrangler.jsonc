{
  "name": "signal-scout",
  "compatibility_date": "2026-08-23",
  "main": "worker-runtime.js",
  "routes": [
    {
      "pattern": "freqbeacon.methvindigitalworks.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
